# zależności — instalowane przez npm w etapie deps
node_modules

# pliki Pythona (nieużywane — projekt przepisany na Node.js)
*.py
requirements.txt

# zmienne środowiskowe — NIGDY nie powinny trafiać do obrazu
.env
.env.*

# logi
*.log
logs/

# artefakty build
dist/
build/
coverage/

# pliki testowe (kopiowane tylko do etapu test, nie do production)
*.test.js
*.spec.js
__tests__/

# git i edytor
.git/
.gitignore
.dockerignore
README.md
